#!/bin/bash
# Pre-commit hook for GenMetaBalls
# Runs formatting and linting checks before allowing commits

set -e

echo "🔧 Running pre-commit checks..."
echo ""

# Step 1: Format files
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Step 1/3: Formatting files..."
FORMAT_OUTPUT=$(pixi run format 2>&1)
FORMAT_EXIT=$?
if [ $FORMAT_EXIT -ne 0 ]; then
    echo "$FORMAT_OUTPUT"
    echo ""
    echo "❌ Formatting failed. Please fix the errors above."
    exit 1
fi
echo "✓ Formatting complete"
echo ""

# Step 2: Check formatting
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Step 2/3: Checking formatting..."
FORMAT_CHECK_OUTPUT=$(pixi run format-check 2>&1)
FORMAT_CHECK_EXIT=$?
if [ $FORMAT_CHECK_EXIT -ne 0 ]; then
    echo "$FORMAT_CHECK_OUTPUT"
    echo ""
    echo "❌ Format check failed. Some files still need formatting."
    echo "💡 Run 'pixi run format' to fix formatting issues."
    exit 1
fi
echo "✓ Format check passed"
echo ""

# Step 3: Lint files
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Step 3/3: Linting files..."
LINT_OUTPUT=$(pixi run lint 2>&1)
LINT_EXIT=$?
if [ $LINT_EXIT -ne 0 ]; then
    echo "$LINT_OUTPUT"
    echo ""
    echo "❌ Linting failed. Please fix the linting errors above."
    echo "💡 Run 'pixi run lint-fix' to auto-fix some issues."
    exit 1
fi
echo "✓ Linting passed"
echo ""

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "✨ All pre-commit checks passed!"
exit 0

